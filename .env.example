# Maintenance mode
# Set to 'true' to take the site down for maintenance. When enabled, all
# requests are rewritten to /maintenance with a 503 status EXCEPT:
#   - the /maintenance page itself (avoids a redirect loop)
#   - all /api/* routes (webhooks, cron jobs, backend functionality keep working)
#   - static assets (/_next/static, /_next/image, favicon.ico, images, etc.)
# Set to 'false' (or leave unset) for normal site behavior.
MAINTENANCE_MODE=false

# Optional bypass secret so you can still preview the live site while
# MAINTENANCE_MODE=true. Visit the site with ?bypass=<this value> once — a
# cookie is set so you stay bypassed for 24h without needing the query param
# on every request. Leave unset to disable the bypass entirely.
MAINTENANCE_BYPASS_SECRET=
